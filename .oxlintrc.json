{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "oxc",
    "unicorn",
    "react",
    "nextjs",
    "jsx-a11y",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "motion/react",
            "importNames": ["m", "motion"],
            "message": "Import m from 'motion/react-m'. The motion/react barrel pulls every Motion feature into the page bundle and defeats LazyMotion."
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    ".claude/**",
    "src/data/snapshot/**",
    "src/tests/coverage/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/unbound-method": "off",
        "typescript/restrict-template-expressions": "off"
      }
    }
  ]
}
