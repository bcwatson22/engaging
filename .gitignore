# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# claude — plans, local config and agent instructions stay private
.claude/
CLAUDE.md
AGENTS.md

# typescript
*.tsbuildinfo
next-env.d.ts

# pageSpeed — the monthly measurement, read by the workflow and not kept.
# Anchored to the root: unanchored, these names also match a test fixture
# called pageSpeed.json anywhere below, which is a file silently missing from
# a clone rather than an error anyone would see.
/pageSpeed.json
/dependencies.json

# eval runs — one directory per run of `claude plugin eval`, holding
# transcripts, grader verdicts and what each run cost. Reproducible from the
# cases, so there is nothing to keep.
/evals/results/
