{
  "name": "engaging",
  "version": "1.1.0",
  "private": true,
  "homepage": "https://github.com/bcwatson22/engaging#readme",
  "author": "Billy Watson <hello@engaging.engineering> (https://www.engaging.engineering)",
  "scripts": {
    "dev": "NODE_ENV=development next dev",
    "build": "pnpm snapshot && NODE_ENV=production next build",
    "snapshot": "node --env-file-if-exists=.env.local ./src/scripts/saveSnapshot.ts",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@bcwatson22/motes": "0.2.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "motion": "13.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@heroicons/react": "2.2.0",
    "@sidekickicons/react": "0.12.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "dayjs": "1.11.21",
    "jsdom": "30.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.26",
    "react-markdown": "9.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    }
  }
}
