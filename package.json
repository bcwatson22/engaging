{
  "name": "engaging",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://github.com/bcwatson22/engaging#readme",
  "author": "Billy Watson <hello@engaging.engineering> (https://www.engaging.engineering)",
  "scripts": {
    "dev": "NODE_ENV=development next dev --webpack",
    "build": "NODE_ENV=production next build --webpack && npx puppeteer browsers install chrome@133 && node ./src/scripts/saveToPdf.ts && node ./src/scripts/saveStartupImages.ts",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@sparticuz/chromium-min": "133.0.0",
    "@urql/core": "4.3.0",
    "@urql/next": "1.1.1",
    "@vercel/analytics": "1.4.1",
    "@vercel/speed-insights": "1.1.0",
    "framer-motion": "11.18.2",
    "graphql": "16.8.1",
    "next": "16.3.0",
    "node": "23.10.0",
    "puppeteer": "24.4.0",
    "puppeteer-core": "24.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "urql": "4.0.6"
  },
  "devDependencies": {
    "@heroicons/react": "2.2.0",
    "@sidekickicons/react": "0.12.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@tsparticles/engine": "3.7.0",
    "@tsparticles/react": "3.0.0",
    "@tsparticles/slim": "3.7.0",
    "@types/node": "20.11.30",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "dayjs": "1.11.21",
    "jsdom": "30.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "postcss": "8.5.26",
    "react-markdown": "9.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.20.0",
