{
  "name": "engaging",
  "version": "1.1.0",
  "private": true,
  "homepage": "https://github.com/bcwatson22/engaging#readme",
  "author": "Billy Watson <hello@engaging.engineering> (https://www.engaging.engineering)",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development next dev",
    "build": "pnpm snapshot && NODE_ENV=production next build",
    "snapshot": "node --env-file-if-exists=.env.local ./src/scripts/saveSnapshot.ts",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --pretty --noEmit",
    "check:scripts": "node --input-type=module -e \"await import('./src/utils/pageSpeed.ts'); await import('./src/utils/saveSnapshot.ts'); await import('./src/utils/dependencies.ts')\"",
    "verify": "pnpm lint && pnpm format:check && pnpm lint:types && pnpm typecheck && pnpm check:scripts && pnpm check:evals && pnpm coverage",
    "check:evals": "node evals/pagespeed/build.ts --check && node evals/dependencies/build.ts --check && node evals/dependencyMajor/build.ts --check",
    "eval": "node evals/pagespeed/build.ts && node evals/dependencies/build.ts && node evals/dependencyMajor/build.ts && claude plugin eval . --eval-dir evals --runs 3 --ablation none --max-cost-usd 12"
  },
  "dependencies": {
    "@bcwatson22/motes": "0.4.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "motion": "14.9.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@heroicons/react": "2.2.0",
    "@next/bundle-analyzer": "16.4.4",
    "@sidekickicons/react": "0.20.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-istanbul": "5.1.0",
    "axe-core": "4.14.0",
    "dayjs": "1.11.23",
    "jsdom": "30.1.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "postcss": "8.5.32",
    "react-markdown": "10.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@10.20.0"
}
