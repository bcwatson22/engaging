{
  "name": "engaging",
  "version": "1.1.0",
  "private": true,
  "homepage": "https://github.com/bcwatson22/engaging#readme",
  "author": "Billy Watson <hello@engaging.engineering> (https://www.engaging.engineering)",
  "scripts": {
    "dev": "NODE_ENV=development next dev",
    "build": "pnpm snapshot && NODE_ENV=production next build",
    "snapshot": "node --env-file-if-exists=.env.local ./src/scripts/saveSnapshot.ts",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --pretty --noEmit",
    "check:scripts": "node --input-type=module -e \"await import('./src/utils/pageSpeed.ts'); await import('./src/utils/saveSnapshot.ts'); await import('./src/utils/dependencies.ts')\"",
    "verify": "pnpm lint && pnpm format:check && pnpm lint:types && pnpm typecheck && pnpm check:scripts && pnpm coverage"
  },
  "dependencies": {
    "@bcwatson22/motes": "0.4.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@heroicons/react": "2.2.0",
    "@next/bundle-analyzer": "16.3.5",
    "@sidekickicons/react": "0.15.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "5.0.1",
    "axe-core": "4.13.0",
    "dayjs": "1.11.23",
    "jsdom": "30.0.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "postcss": "8.5.28",
    "react-markdown": "10.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    }
  }
}
